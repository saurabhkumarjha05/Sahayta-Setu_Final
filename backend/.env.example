# Sahayta Setu Environment Configuration
# Copy this file to .env and configure the values for your environment.

# MongoDB Connection String (Required)
# Connects to MongoDB Atlas or local MongoDB instance
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/sahayta_setu?retryWrites=true&w=majority

# JWT Authentication (Required, min 32 characters in production)
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-characters-long
JWT_EXPIRES_IN=12h

# Super Admin Bootstrap Credentials (set a unique password in your local .env)
SUPER_ADMIN_EMAIL=superadmin@sahaytasetu.gov.in
SUPER_ADMIN_PASSWORD=replace-with-a-unique-strong-password

# Citizen authentication defaults to OTP. Phone-only authentication is restricted
# to explicit non-production demo configuration: APP_MODE=demo + phone_only.
CITIZEN_AUTH_MODE=otp
APP_MODE=demo

# OTP Delivery Mechanism: console (local development only) | sms
OTP_DELIVERY=console

# Twilio (required when SMS_ENABLED=true or OTP_SMS_ENABLED=true)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMS_ENABLED=false
OTP_SMS_ENABLED=false

# Allowed CORS Origins (comma-separated, default: * in dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Server Port
PORT=5000
